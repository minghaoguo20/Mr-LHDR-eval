# Copy to .env and fill in. Never commit the filled-in file.
# The CLI does not read .env itself -- export these, or use your own loader:
#   set -a; . ./.env; set +a

# --- the system under evaluation ------------------------------------------
# Either use OpenRouter with `benchmark-eval run --openrouter` ...
OPENROUTER_API_KEY=

# ... or point at any OpenAI-compatible endpoint (vLLM, SGLang, Ollama, a vendor).
# /v1 is appended if you leave it off.
EVAL_BASE_URL=
EVAL_API_KEY=
# Optional. Set this when the endpoint is only reachable through a specific hop
# (a VPN's own SOCKS5, say). Setting it ALSO makes the call ignore
# HTTP_PROXY/ALL_PROXY -- otherwise a general-purpose proxy exported on the
# machine would grab the traffic and answer 502.
#   EVAL_PROXY=socks5://127.0.0.1:1055
EVAL_PROXY=

# --- the judge -------------------------------------------------------------
# Judging is a text-only task, so any capable model can do it; the endpoint
# does not have to be the same one that answered.
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_MODEL=
EVAL_JUDGE_API_KEY=
# "openai" (default) or "anthropic" for /v1/messages-format endpoints.
# NOTE the asymmetry, a common source of 404s:
#   openai     -> base url ENDS in /v1        (appended for you if omitted)
#   anthropic  -> base url must NOT have /v1  ("/v1/messages" is appended at call time)
EVAL_JUDGE_API=openai
# Optional: the id recorded in the verdicts, if it should differ from the model id
EVAL_JUDGE_LABEL=
EVAL_JUDGE_PROXY=
